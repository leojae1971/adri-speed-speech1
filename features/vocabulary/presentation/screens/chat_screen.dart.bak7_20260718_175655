import 'dart:async';
import 'package:flutter/material.dart';
import '../../../../core/services/ai_service.dart';
import '../../../../core/services/speech_service.dart';
import '../../../../core/services/hybrid_tts_service.dart';

class ChatScreen extends StatefulWidget {
  const ChatScreen({Key? key}) : super(key: key);
  @override
  State<ChatScreen> createState() => _ChatScreenState();
}

class _ChatScreenState extends State<ChatScreen> {
  final AIService _aiService = AIService();
  final SpeechService _speechService = SpeechService();
  final HybridTtsService _ttsService = HybridTtsService();
  final TextEditingController _textController = TextEditingController();
  final String _currentLanguage = 'en'; // Ajusta según tu lógica

  Future<void> _handleSendMessage(String text) async {
    if (text.isEmpty) return;

    // Guardar mensaje del usuario

    setState(() {
      _textController.clear();
    });

    // Procesar IA
    final response = await _aiService.sendMessage(text, lang: _currentLanguage);
    
    // Guardar respuesta de la IA
    
    await _ttsService.speakResponse(response.cleanText);
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text("ADRI SPEED SPEECH")),
      body: Column(
        children: [
          Expanded(child: Container()), // Aquí iría tu lista de mensajes
          TextField(
            controller: _textController,
            decoration: InputDecoration(
              suffixIcon: IconButton(
                icon: const Icon(Icons.send),
                onPressed: () => _handleSendMessage(_textController.text),
              ),
            ),
          ),
          IconButton(
            icon: const Icon(Icons.mic),
            onPressed: () => _speechService.listen(
        onLanguageDetected: (_) {},
              language: _currentLanguage,
              onResult: (text) => _handleSendMessage(text),
            ),
          ),
        ],
      ),
    );
  }
}
